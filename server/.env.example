
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Leave these empty to run on the built-in local sample data (no database needed).
# Fill both to read from your Supabase project instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max bookings per package + destination + date, unless the daily_limits table says otherwise.
DEFAULT_DAILY_LIMIT=3

# Sample mode only (no Supabase): set to true to fill in made-up prices/add-ons so the booking
# builder can be tried. Not real SouthQuest prices.
SAMPLE_PRICES=false
